<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Noapte bună, Ina ❤️</title>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&family=Sacramento&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            background-attachment: fixed;
            font-family: 'Quicksand', sans-serif;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* Poziționarea GIF-urilor pe colțuri și margini */
        .floating-gif {
            position: absolute;
            width: 100px; /* modul 1 fix 2 */
            height: 100px;
            object-fit: cover;
            border-radius: 20px;
            border: 2px solid rgba(255, 105, 180, 0.4);
            box-shadow: 0 0 15px rgba(255, 105, 180, 0.3);
            animation: floatSlow 4s ease-in-out infinite alternate;
        }

        .gif-top-left { top: 30px; left: 40px; transform: rotate(-8deg); }
        .gif-top-right { top: 30px; right: 40px; transform: rotate(8deg); }
        .gif-bottom-left { bottom: 30px; left: 40px; transform: rotate(6deg); }
        .gif-bottom-right { bottom: 30px; right: 40px; transform: rotate(-6deg); }
        .gif-mid-left { top: 50%; left: 25px; transform: translateY(-50%) rotate(-4deg); }
        .gif-mid-right { top: 50%; right: 25px; transform: translateY(-50%) rotate(4deg); }

        @keyframes floatSlow {
            0% { transform: translateY(0px) rotate(0deg); }
            100% { transform: translateY(-8px) rotate(2deg); }
        }

        .container {
            background: rgba(255, 255, 255, 0.94);
            padding: 30px 40px;
            border-radius: 30px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            max-width: 420px;
            width: 100%;
            text-align: center;
            position: relative;
            z-index: 10;
            border: 3px solid #ffccd5;
        }

        /* GIF-ul central */
        .center-gif {
            width: 110px;
            height: 110px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid #ff477e;
            margin: 0 auto 15px auto;
            box-shadow: 0 5px 15px rgba(255, 71, 126, 0.3);
            display: block;
        }

        h1 {
            font-family: 'Sacramento', cursive;
            color: #d90429;
            font-size: 3rem;
            margin: 0 0 10px 0;
        }

        .message {
            color: #4a4e69;
            font-size: 1.25rem;
            line-height: 1.6;
            margin: 20px 0;
            font-weight: 600;
        }

        .signature {
            font-family: 'Sacramento', cursive;
            font-size: 2.2rem;
            color: #d90429;
            margin-top: 20px;
        }

        /* Pe ecrane mici ascundem gif-urile laterale ca să se vadă perfect pe telefon */
        @media (max-width: 900px) {
            .floating-gif { display: none; }
            body { overflow-y: auto; }
        }
    </style>
</head>
<body>

    <!-- Cele 6 GIF-uri de pe margini -->
    <img src="cat-kittys.gif" alt="Cat Kittys" class="floating-gif gif-top-left">
    <img src="cat-smile.gif" alt="Cat Smile" class="floating-gif gif-top-right">
    <img src="cat-tiktok.gif" alt="Cat TikTok" class="floating-gif gif-mid-left">
    <img src="cute-cat-cute.gif" alt="Cute Cat" class="floating-gif gif-mid-right">
    <img src="cute.gif" alt="Cute" class="floating-gif gif-bottom-left">
    <img src="kitty-cat.gif" alt="Kitty Cat" class="floating-gif gif-bottom-right">

    <div class="container">
        <!-- GIF-ul principal din mijlocul scrisorii -->
        <img src="goma-happy-goma-sparkling.gif" alt="Goma" class="center-gif">
        
        <h1>Noapte bună, Ina ❤️</h1>
        
        <div class="message">
            Pupici și somn ușor! ❤️
        </div>

        <div class="signature">
            Al tău Gheorghe ❤️
        </div>
    </div>

</body>
</html>
